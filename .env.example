# =============================================================
# .env.example — NABDH AI Maintenance Platform
# Copy to .env and fill all values before running
# NEVER commit .env to version control
# =============================================================

# ── JWT Security ─────────────────────────────────────────────
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(64))"
JWT_SECRET_KEY=REPLACE_WITH_64_CHAR_RANDOM_STRING
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# ── Default Users (Phase 1 — in-memory, migrated to DB in Phase 2) ──
# Change ALL passwords before any deployment
ADMIN_USERNAME=admin
ADMIN_PASSWORD=REPLACE_WITH_STRONG_PASSWORD
OPERATOR_USERNAME=operator
OPERATOR_PASSWORD=REPLACE_WITH_STRONG_PASSWORD
VIEWER_USERNAME=viewer
VIEWER_PASSWORD=REPLACE_WITH_STRONG_PASSWORD

# ── Rate Limiting ─────────────────────────────────────────────
RATE_LIMIT=100/minute

# ── ML Pipeline ───────────────────────────────────────────────
THRESHOLD=0.70
ALERT_MIN_CONFIDENCE=0.85
PIPELINE_PATH=pipeline.pkl
COLUMNS_PATH=expected_columns.pkl
MODEL_VERSION_PATH=model_version.json
REFERENCE_DATA_PATH=reference_data.csv

# ── Database ──────────────────────────────────────────────────
DATABASE_PATH=nabdh.db

# ── Drift Detection ───────────────────────────────────────────
DRIFT_WINDOW_SIZE=500
DRIFT_KS_THRESHOLD=0.05
MIN_SAMPLES_DRIFT=50
DRIFT_FEATURE_LIMIT=3

# ── Alerting ──────────────────────────────────────────────────
ALERT_WEBHOOK_URL=

# ── CORS ──────────────────────────────────────────────────────
# Comma-separated — do NOT use * in production
ALLOWED_ORIGINS=http://localhost:8501,http://localhost:3000

# ── Redis ─────────────────────────────────────────────────────
# In Docker: redis://redis:6379/0  (set automatically by docker-compose)
# Local dev: leave empty to use in-memory fallback (tokens lost on restart)
REDIS_URL=redis://localhost:6379/0

# ── Dashboard ─────────────────────────────────────────────────
BACKEND_URL=http://127.0.0.1:8000
